BOT_TOKEN=
ADMIN_CHAT_ID=            # required: chat for lead cards
ADMIN_IDS=                # comma-separated tg ids, e.g. 123,456

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

POLZA_API_KEY=
POLZA_BASE_URL=https://polza.ai/api/v1
POLZA_IMAGE_MODEL=        # Nano Banana, exact id from Polza docs
POLZA_STT_MODEL=openai/whisper-1
POLZA_STT_PROVIDER=openai  # optional: pin STT to one Polza provider

CRM_WEBHOOK_URL=          # empty -> LogCrmClient; treated as a secret in logs
PRICING_PATH=config/pricing.yaml
CATALOG_PATH=assets/catalog/catalog.yaml  # catalog seed; images are relative to it
LEAD_RETRY_INTERVAL_S=300  # re-delivery of leads stuck in qualified / without a card
DATABASE_URL=sqlite+aiosqlite:///data/app.db
TRYON_DAILY_LIMIT=5
THROTTLE_MAX_MESSAGES=10   # per user per window
THROTTLE_WINDOW_S=60
LOG_LEVEL=INFO
